<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="168dp"
    android:gravity="top"
    android:orientation="vertical"
    android:paddingLeft="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cardMapBackground"
        android:gravity="top"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/locationIc"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_room_24px_outlined" />


            <TextView
                android:id="@+id/addressTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:layout_toStartOf="@id/showMapTV"
                android:layout_toEndOf="@id/locationIc"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/cardMapTextColor"
                android:textSize="15sp"
                tools:text="Middenweg 212, 1701GH, Heerhugowaard" />

            <TextView
                android:id="@+id/showMapTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="right|top"
                android:lineSpacingExtra="1sp"
                android:text="@string/show_map"
                android:textColor="@color/colorAccent"
                android:textSize="12sp"
                android:translationY="-0.37sp" />

        </RelativeLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="13dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/phoneIc"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_call_24px_rounded" />


            <TextView
                android:id="@+id/phoneTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:layout_toEndOf="@id/phoneIc"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/cardMapTextColor"
                android:textSize="15sp"
                tools:text="0615 261 612" />


        </RelativeLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/timeIc"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_access_time_24px_rounded" />


            <TextView
                android:id="@+id/timeTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:layout_toEndOf="@id/timeIc"
                android:ellipsize="end"
                android:lineSpacingExtra="4sp"
                android:maxLines="3"
                android:textColor="@color/cardMapTextColor"
                android:textSize="15sp"
                tools:text="Mandaag – Vrijdag: 08:00 – 16 \nZaterdag: 12:00 – 20:59\nZaterdag: 12:00 – 20:59\nZaterdag: 12:00 – 20:59\nZaterdag: 12:00 – 20:59" />


        </RelativeLayout>

    </LinearLayout>


</LinearLayout>